@model SmileAnalysisBl.ViewModels.GummySmileViewModels.GummySmileClinicalViewModel
@{
    ViewData["Title"] = "Clinical Measurements";
}

<div class="cc-page">
    <div class="pa-analysis-header">
        <a asp-action="Review" asp-route-id="@Model.LocalCaseId" class="pa-back-btn" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h1 class="h4 fw-bold text-dark mb-0">Gummy Smile Analysis</h1>
                <span class="pa-ai-badge"><i class="bi bi-stars"></i> AI Powered</span>
            </div>
            <p class="text-secondary small mb-0">@Model.PatientName · @Model.DisplayId · @Model.PatientAge yrs · @Model.PatientSex</p>
        </div>
    </div>

    <partial name="_WizardSteps" model="Model" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.HasDraft)
    {
        <div class="alert alert-info small py-2">
            <i class="bi bi-save me-1"></i> A local draft is loaded. Submit when ready to compute diagnosis.
        </div>
    }

    <div class="pa-form-card">
        <h2 class="h6 fw-bold mb-2">Step 3 — Clinical inputs</h2>
        <p class="text-secondary small mb-4">
            Chart and exam measurements the AI cannot infer from photos. Leave fields blank if unknown — do not enter 0 unless clinically zero.
            Patient age and sex are sent automatically for norm calculations.
        </p>

        <form asp-action="Clinical" method="post" id="clinicalForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LocalCaseId" />
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="GsCaseId" />
            <input type="hidden" asp-for="DisplayId" />
            <input type="hidden" asp-for="PatientName" />
            <input type="hidden" asp-for="GsStatus" />
            <input type="hidden" asp-for="CurrentStep" />
            <input type="hidden" asp-for="PatientAge" />
            <input type="hidden" asp-for="PatientSex" />

            <h3 class="h6 fw-bold mb-3">Periodontal probing (FDI, mm)</h3>
            <div class="row g-2 mb-4">
                @for (var i = 0; i < Model.ProbingDepths.Count; i++)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <label class="form-label small fw-semibold mb-1">@Model.ProbingDepths[i].Fdi</label>
                        <input type="hidden" asp-for="ProbingDepths[i].Fdi" />
                        <input type="hidden" asp-for="ProbingDepths[i].ToothLabel" />
                        <input asp-for="ProbingDepths[i].DepthMm" class="form-control form-control-sm" type="number" step="0.1" min="0" placeholder="—" />
                    </div>
                }
            </div>

            <h3 class="h6 fw-bold mb-3">Cephalometric &amp; crown measures</h3>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="pa-float-group">
                        <input asp-for="U1FeopMm" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                        <label asp-for="U1FeopMm" class="pa-float-label"></label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="pa-float-group">
                        <input asp-for="SnU1Deg" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                        <label asp-for="SnU1Deg" class="pa-float-label"></label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="pa-float-group">
                        <input asp-for="NfcADeg" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                        <label asp-for="NfcADeg" class="pa-float-label"></label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="pa-float-group">
                        <input asp-for="FacialAxisDeg" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                        <label asp-for="FacialAxisDeg" class="pa-float-label"></label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="pa-float-group">
                        <input asp-for="CrownWidthMm" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                        <label asp-for="CrownWidthMm" class="pa-float-label"></label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="pa-float-group">
                        <input asp-for="CrownLengthMm" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                        <label asp-for="CrownLengthMm" class="pa-float-label"></label>
                    </div>
                </div>
            </div>

            <div asp-validation-summary="All" class="text-danger small mt-3"></div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn cc-btn-primary px-4">
                    <i class="bi bi-clipboard2-pulse me-2"></i>Save &amp; Compute Diagnosis
                </button>
                <button type="submit" formaction="@Url.Action("SaveClinicalDraft")" formmethod="post" class="btn btn-outline-primary px-4">
                    <i class="bi bi-save me-2"></i>Save Draft Locally
                </button>
                <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
