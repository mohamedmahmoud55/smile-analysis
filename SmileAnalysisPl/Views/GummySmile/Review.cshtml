@model SmileAnalysisBl.ViewModels.GummySmileViewModels.GummySmileReviewViewModel
@{
    ViewData["Title"] = "Review AI Outputs";
}

<div class="cc-page">
    <div class="pa-analysis-header">
        <a asp-action="Analyze" asp-route-id="@Model.LocalCaseId" class="pa-back-btn" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h1 class="h4 fw-bold text-dark mb-0">Gummy Smile Analysis</h1>
                <span class="pa-ai-badge"><i class="bi bi-stars"></i> AI Powered</span>
            </div>
            <p class="text-secondary small mb-0">@Model.PatientName · @Model.DisplayId</p>
        </div>
    </div>

    <partial name="_WizardSteps" model="Model" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.LowScaleConfidence)
    {
        <div class="alert alert-warning small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Scale calibration confidence is low. Verify mm measurements or use the GS5 UI for scale/landmark overrides.
        </div>
    }

    <div class="pa-form-card mb-4">
        <h2 class="h6 fw-bold mb-2">Step 2 — Review &amp; calibrate</h2>
        <p class="text-secondary small mb-4">
            These values were derived from photos during analyze. Override per-tooth gingival display (GD) below if the AI measurement looks wrong.
            Scale and landmark corrections require the GS5 annotator (deferred in v1).
        </p>

            <div class="row g-3 mb-4">
                @if (Model.Measurements?.MaxGdMm is not null)
            {
                <div class="col-6 col-md-3">
                    <div class="small text-secondary">Max GD</div>
                    <div class="fw-bold">@Model.Measurements.MaxGdMm.Value.ToString("0.#") mm</div>
                </div>
            }
            @if (Model.Measurements?.LipMobilityMm is not null)
            {
                <div class="col-6 col-md-3">
                    <div class="small text-secondary">Lip mobility</div>
                    <div class="fw-bold">@Model.Measurements.LipMobilityMm.Value.ToString("0.#") mm</div>
                </div>
            }
            @if (Model.Measurements?.HypermobilityMm is not null)
            {
                <div class="col-6 col-md-3">
                    <div class="small text-secondary">Hypermobility</div>
                    <div class="fw-bold">@Model.Measurements.HypermobilityMm.Value.ToString("0.#") mm</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Measurements?.Severity))
            {
                <div class="col-6 col-md-3">
                    <div class="small text-secondary">AI severity</div>
                    <div class="fw-bold">@Model.Measurements!.Severity</div>
                </div>
            }
        </div>

        @if (Model.AiWarnings.Any())
        {
            <div class="alert alert-info small">
                @string.Join(" ", Model.AiWarnings)
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SmileOverlayPath) || !string.IsNullOrEmpty(Model.RestOverlayPath))
        {
            <div class="row g-3 mb-4">
                @if (!string.IsNullOrEmpty(Model.RestOverlayPath))
                {
                    <div class="col-12 col-md-6">
                        <div class="small fw-bold text-secondary mb-1">Rest overlay</div>
                        <img class="gs-overlay-img" alt="Rest overlay"
                             src="@Url.Action("Asset", new { id = Model.LocalCaseId, path = Model.RestOverlayPath })" />
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.SmileOverlayPath))
                {
                    <div class="col-12 col-md-6">
                        <div class="small fw-bold text-secondary mb-1">Smile overlay</div>
                        <img class="gs-overlay-img" alt="Smile overlay"
                             src="@Url.Action("Asset", new { id = Model.LocalCaseId, path = Model.SmileOverlayPath })" />
                    </div>
                }
            </div>
        }

        <form asp-action="Review" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LocalCaseId" />
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="GsCaseId" />
            <input type="hidden" asp-for="DisplayId" />
            <input type="hidden" asp-for="PatientName" />
            <input type="hidden" asp-for="GsStatus" />
            <input type="hidden" asp-for="CurrentStep" />
            <input type="hidden" asp-for="PatientAge" />
            <input type="hidden" asp-for="PatientSex" />

            @if (Model.GdOverrides.Any())
            {
                <h3 class="h6 fw-bold mb-3">Per-tooth GD overrides (optional)</h3>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>FDI</th>
                                <th>Class</th>
                                <th>Side</th>
                                <th>AI GD (mm)</th>
                                <th>Override (mm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.GdOverrides.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @(Model.GdOverrides[i].Fdi?.ToString() ?? "—")
                                        <input type="hidden" asp-for="GdOverrides[i].Fdi" />
                                        <input type="hidden" asp-for="GdOverrides[i].SegClass" />
                                        <input type="hidden" asp-for="GdOverrides[i].Side" />
                                        <input type="hidden" asp-for="GdOverrides[i].AiGdMm" />
                                    </td>
                                    <td>@Model.GdOverrides[i].SegClass</td>
                                    <td>@Model.GdOverrides[i].Side</td>
                                    <td>@Model.GdOverrides[i].AiGdMm.ToString("0.#")</td>
                                    <td>
                                        <input asp-for="GdOverrides[i].OverrideGdMm" class="form-control form-control-sm" type="number" step="0.1" placeholder="Leave blank to keep AI" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="small text-secondary mb-0">No per-tooth GD data returned from analyze. Continue to clinical inputs.</p>
            }

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn cc-btn-primary px-4">
                    <i class="bi bi-arrow-right me-2"></i>Continue to Clinical
                </button>
                <a asp-controller="Patient" asp-action="Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>
