@model SmileAnalysisBl.ViewModels.AdminManamentViewModels.EditAdminViewModel
@{
    ViewData["Title"] = "Edit user";
}

<div class="cc-page">
    <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <a asp-action="Index" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Back to users & roles</a>
            <h2 class="h4 fw-bold text-dark mt-2 mb-1">Edit user</h2>
            <p class="text-secondary small mb-0">Update account email and username.</p>
        </div>
        <a asp-action="ManageRoles" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm rounded-pill d-inline-flex align-items-center gap-1">
            <i class="bi bi-shield-lock"></i>
            Manage roles
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ok
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string bad)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @bad
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="cc-bento-card p-4" style="max-width: 36rem;">
        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                <i class="bi bi-person-gear fs-5"></i>
            </div>
            <h3 class="cc-form-section-title mb-0">Account details</h3>
        </div>

        <form asp-action="Edit" method="post" class="row g-3">
            <input type="hidden" asp-for="Id" />
            <div class="col-12">
                <label asp-for="Email" class="form-label fw-semibold small"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="UserName" class="form-label fw-semibold small"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                <button type="submit" class="btn cc-btn-primary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-check2"></i>
                    Save changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
