@model SmileAnalysisBl.ViewModels.AdminManamentViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="cc-page">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Back to users & roles</a>
        <h2 class="h4 fw-bold text-dark mt-2 mb-1">Reset password</h2>
        <p class="text-secondary small mb-0">Set a new password for this account.</p>
    </div>

    <div class="cc-bento-card p-4" style="max-width: 36rem;">
        <div class="d-flex align-items-center gap-2 mb-4">
            <div class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis">
                <i class="bi bi-key fs-5"></i>
            </div>
            <h3 class="cc-form-section-title mb-0">New password</h3>
        </div>

        <form asp-action="ResetPassword" method="post" class="row g-3">
            <input type="hidden" asp-for="Id" />
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>
            }
            <div class="col-12">
                <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                <button type="submit" class="btn cc-btn-primary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-check2"></i>
                    Reset password
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
