@model SmileAnalysisBl.ViewModels.DoctorViewModels.DoctorSchedulePickerViewModel
@{
    ViewData["Title"] = "Doctor schedule";
}

<div class="cc-page">
    <div class="mb-4">
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <a asp-controller="Doctor" asp-action="Index" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Back to medical team</a>
        }
        else
        {
            <a asp-controller="Patient" asp-action="Index" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Back to patients</a>
        }
        <h2 class="h4 fw-bold text-dark mt-2 mb-1">Doctor schedule</h2>
        <p class="text-secondary small mb-0">Choose a doctor to view their appointments and date range.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="cc-bento-card p-4 h-100">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                        <i class="bi bi-person-badge fs-5"></i>
                    </div>
                    <h3 class="cc-form-section-title mb-0">Select doctor</h3>
                </div>
                @if (!Model.Doctors.Any())
                {
                    <p class="text-secondary mb-0">No doctors are in the system yet.</p>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <a class="btn cc-btn-primary mt-3" asp-controller="Doctor" asp-action="Create">Add doctor</a>
                    }
                }
                else
                {
                    <form asp-controller="Doctor" asp-action="Schedule" method="get" class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small" for="schedule-doctor-id">Doctor</label>
                            <select name="id" id="schedule-doctor-id" class="form-select" required asp-items="Model.Doctors">
                                <option value="">— Select doctor —</option>
                            </select>
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-2 pt-1">
                            <button type="submit" class="btn cc-btn-primary d-inline-flex align-items-center gap-2">
                                <i class="bi bi-calendar-check"></i>
                                View schedule
                            </button>
                            <a class="btn btn-outline-secondary" asp-controller="Appointment" asp-action="Index">
                                All appointments
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
        <div class="col-12 col-lg-7">
            <div class="cc-bento-card p-4 h-100">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-info-circle fs-5"></i>
                    </div>
                    <h3 class="cc-form-section-title mb-0">How it works</h3>
                </div>
                <ul class="small text-secondary mb-0 ps-3">
                    <li class="mb-2">Pick a doctor to see their appointments for a date range.</li>
                    <li class="mb-2">Default view covers today through the next six weeks.</li>
                    <li class="mb-0">To book a new visit, use <a asp-controller="Appointment" asp-action="Create" class="text-decoration-none">Schedule appointment</a>.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
