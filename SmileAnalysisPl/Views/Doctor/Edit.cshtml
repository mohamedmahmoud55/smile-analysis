@model SmileAnalysisBl.ViewModels.DoctorViewModels.EditDoctorViewModel
@{
    ViewData["Title"] = "Edit doctor";
}

<div class="cc-page">
    <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <a asp-action="Index" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Back to medical team</a>
            <h2 class="h4 fw-bold text-dark mt-2 mb-1">Edit doctor</h2>
            <p class="text-secondary small mb-0">Update profile, credentials, and contact details.</p>
        </div>
        <a asp-action="Availability" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm rounded-pill d-inline-flex align-items-center gap-1">
            <i class="bi bi-calendar-week"></i>
            Weekly availability
        </a>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-lg-5">
                <div class="cc-bento-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                            <i class="bi bi-person-badge fs-5"></i>
                        </div>
                        <h3 class="cc-form-section-title mb-0">Personal details</h3>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold small"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="BirthDate" class="form-label fw-semibold small"></label>
                            <input asp-for="BirthDate" class="form-control" type="date" />
                            <span asp-validation-for="BirthDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="cc-bento-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis">
                            <i class="bi bi-mortarboard fs-5"></i>
                        </div>
                        <h3 class="cc-form-section-title mb-0">Professional credentials</h3>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Specialty" class="form-label fw-semibold small"></label>
                            <input asp-for="Specialty" class="form-control" />
                            <span asp-validation-for="Specialty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LicenseNumber" class="form-label fw-semibold small"></label>
                            <input asp-for="LicenseNumber" class="form-control cc-numeric-only" inputmode="numeric" pattern="[0-9]*" />
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="cc-bento-card p-4">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="p-2 rounded-3 bg-success-subtle text-success-emphasis">
                            <i class="bi bi-telephone fs-5"></i>
                        </div>
                        <h3 class="cc-form-section-title mb-0">Contact information</h3>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="cc-intl-phone-field">
                                <label asp-for="Phone" class="form-label fw-semibold small"></label>
                                <input asp-for="Phone" class="form-control cc-intl-phone" type="tel" autocomplete="tel" />
                                <span class="text-danger small cc-phone-error" role="alert"></span>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn cc-btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-check2"></i>
                Save changes
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Styles {
    <partial name="_FormInputStylesPartial" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <partial name="_FormInputScriptsPartial" />
}
