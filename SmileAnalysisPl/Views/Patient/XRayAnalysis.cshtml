@model SmileAnalysisBl.ViewModels.PatientViewModels.XRayAnalysisViewModel
@{
    ViewData["Title"] = "X-Ray Analysis";
}

<div class="cc-page">
    <div class="pa-analysis-header">
        <a asp-action="Details" asp-route-id="@Model.PatientId" class="pa-back-btn" title="Back to patient">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h1 class="h4 fw-bold text-dark mb-0">X-Ray Analysis</h1>
                <span class="pa-ai-badge"><i class="bi bi-cpu"></i> AI Landmarks</span>
            </div>
            <p class="text-secondary small mb-0">@Model.PatientName · @Model.DisplayId</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <!-- Upload -->
            <div class="pa-form-card mb-4">
                <h2 class="h6 fw-bold mb-3">Upload Cephalogram</h2>
                <div class="pa-upload-zone" id="xrayUploadZone" style="min-height:14rem;">
                    <input type="file" accept="image/*" aria-label="Upload X-Ray image" />
                    <div class="pa-upload-placeholder text-center">
                        <div class="pa-upload-icon mx-auto"><i class="bi bi-cloud-arrow-up"></i></div>
                        <div class="pa-upload-label">Drag &amp; Drop X-Ray Image</div>
                        <div class="pa-upload-hint">Supports JPG, PNG · Lateral cephalogram recommended</div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="button" id="analyzeXrayBtn" class="btn cc-btn-primary px-4" disabled>
                        <i class="bi bi-stars me-2"></i>Analyze X-Ray
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </div>

            <!-- Original -->
            <div class="pa-form-card mb-4" style="display:none;" id="xrayOriginalCard">
                <h2 class="h6 fw-bold mb-3"><i class="bi bi-image me-2 text-secondary"></i>Original X-Ray</h2>
                <div id="xrayOriginalPanel" class="rounded overflow-hidden" style="background:#0a0f1a;">
                    <div class="pa-empty-state border-0 bg-transparent py-5">
                        <div class="pa-empty-icon"><i class="bi bi-radioactive"></i></div>
                        <p class="small text-secondary mb-0">Original image will appear here</p>
                    </div>
                </div>
            </div>

            <!-- Processed -->
            <div class="pa-form-card mb-4" style="display:none;" id="xrayProcessedPanel">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h6 fw-bold mb-0"><i class="bi bi-stars me-2 text-info"></i>AI Processed Image</h2>
                    <span class="pa-ai-badge"><i class="bi bi-broadcast"></i> Live Detection</span>
                </div>
                <div class="pa-xray-viewer" id="xrayViewer">
                    <div class="pa-empty-state border-0 bg-transparent py-5">
                        <div class="pa-skeleton pa-skeleton-avatar mx-auto mb-2"></div>
                        <div class="pa-skeleton pa-skeleton-text mx-auto" style="width:50%;"></div>
                    </div>
                </div>
            </div>

            <!-- Result -->
            <div class="pa-result-card visible" style="display:none;" id="xrayResultPanel">
                <div class="pa-result-header">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 position-relative" style="z-index:1;">
                        <div>
                            <span class="pa-ai-badge mb-2"><i class="bi bi-stars"></i> AI Result</span>
                            <h2 class="h5 fw-bold mb-1" id="xrayFinding">Awaiting analysis</h2>
                            <p class="text-white-50 small mb-0">Cephalometric assessment complete</p>
                        </div>
                        <div class="pa-confidence-ring" style="--confidence: 95%;">
                            <span class="pa-confidence-value text-white" id="xrayConfidence">—</span>
                        </div>
                    </div>
                </div>
                <div class="p-4">
                    <div class="pa-recommendation">
                        <div class="pa-recommendation-title"><i class="bi bi-clipboard2-pulse me-1"></i> Clinical Summary</div>
                        <p class="small mb-0">AI landmark detection identified 12 cephalometric points with high confidence. Skeletal relationship and dental alignment parameters are within expected clinical ranges for further orthodontic evaluation.</p>
                    </div>
                    <div class="mt-4 pt-3 border-top">
                        <h3 class="h6 fw-bold mb-2">Doctor Notes</h3>
                        <textarea class="pa-notes-area" placeholder="Document findings, measurements, and treatment recommendations…" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Landmarks Panel -->
        <div class="col-12 col-lg-5">
            <div class="pa-preview-card" style="position:sticky;top:5rem;">
                <div class="pa-preview-head">
                    <h2 class="h6 fw-bold mb-0">AI Detected Points</h2>
                </div>
                <div class="pa-preview-body">
                    <div id="xrayLandmarksPanel" style="display:none;">
                        <div class="pa-landmarks-panel mb-3" id="landmarksList"></div>
                        <div class="pa-ai-status success">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>12 landmarks detected successfully</span>
                        </div>
                    </div>
                    <div id="xrayLandmarksEmpty">
                        <div class="pa-empty-state border-0 py-4">
                            <div class="pa-empty-icon"><i class="bi bi-crosshair"></i></div>
                            <p class="fw-semibold mb-1">No landmarks detected</p>
                            <p class="small text-secondary mb-0">Upload an X-ray and run analysis to detect cephalometric landmarks automatically.</p>
                        </div>
                        <div class="mt-3">
                            <div class="small text-secondary mb-2 fw-bold">Expected Landmarks</div>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var lm in new[] { "N", "S", "A", "B", "Pog", "U1", "L1", "Go", "Me", "ANS", "PNS", "Ar" })
                                {
                                    <span class="badge bg-light text-secondary border fw-normal">@lm</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/patient-analysis.js" asp-append-version="true"></script>
    <script>
        document.getElementById('xrayUploadZone')?.addEventListener('pa:image-uploaded', function () {
            document.getElementById('xrayOriginalCard').style.display = '';
        });
        document.getElementById('analyzeXrayBtn')?.addEventListener('click', function () {
            setTimeout(function () {
                document.getElementById('xrayLandmarksEmpty').style.display = 'none';
            }, 2800);
        });
    </script>
}
