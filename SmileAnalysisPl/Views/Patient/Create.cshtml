@using SmileAnalysisDal.Entities.Enums
@model SmileAnalysisBl.ViewModels.PatientViewModels.CreatePatientViewModel
@{
    ViewData["Title"] = "Add patient";
}

<div class="cc-page">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left me-1"></i>Back to patient records</a>
        <h2 class="h4 fw-bold text-dark mt-2 mb-1">Add patient</h2>
        <p class="text-secondary small mb-0">Enter personal and contact details. Clinical history is optional and can be added later.</p>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-lg-5">
                <div class="cc-bento-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                            <i class="bi bi-person-vcard fs-5"></i>
                        </div>
                        <h3 class="cc-form-section-title mb-0">Personal details</h3>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold small"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Gender" class="form-label fw-semibold small"></label>
                            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()"></select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold small"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="cc-bento-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="p-2 rounded-3 bg-success-subtle text-success-emphasis">
                            <i class="bi bi-telephone fs-5"></i>
                        </div>
                        <h3 class="cc-form-section-title mb-0">Contact information</h3>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="cc-intl-phone-field">
                                <label asp-for="Phone" class="form-label fw-semibold small"></label>
                                <input asp-for="Phone" class="form-control cc-intl-phone" type="tel" autocomplete="tel" />
                                <span class="text-danger small cc-phone-error" role="alert"></span>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="patient@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>
                    <p class="small text-muted mb-0 mt-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Phone and email are used for appointment reminders and follow-up.
                    </p>
                </div>
            </div>

            <div class="col-12">
                <div class="cc-bento-card p-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis">
                            <i class="bi bi-journal-medical fs-5"></i>
                        </div>
                        <div>
                            <h3 class="cc-form-section-title mb-0">Clinical history</h3>
                            <p class="small text-muted mb-0 mt-1">Optional — you can add or update this when editing the patient.</p>
                        </div>
                    </div>
                    <div class="mt-3">
                        @Html.EditorFor(m => m.Clinical)
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn cc-btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-person-plus"></i>
                Save patient
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Styles {
    <partial name="_FormInputStylesPartial" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <partial name="_FormInputScriptsPartial" />
}
