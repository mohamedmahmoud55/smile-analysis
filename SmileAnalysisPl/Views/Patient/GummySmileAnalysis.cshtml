@model SmileAnalysisBl.ViewModels.PatientViewModels.GummySmileAnalysisViewModel
@{
    ViewData["Title"] = "Gummy Smile Analysis";
}

<div class="cc-page">
    <div class="pa-analysis-header">
        <a asp-action="Details" asp-route-id="@Model.PatientId" class="pa-back-btn" title="Back to patient">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h1 class="h4 fw-bold text-dark mb-0">Gummy Smile Analysis</h1>
                <span class="pa-ai-badge"><i class="bi bi-stars"></i> AI Powered</span>
            </div>
            <p class="text-secondary small mb-0">@Model.PatientName · @Model.DisplayId</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Form -->
        <div class="col-12 col-lg-7 col-xl-8">
            <form id="gummySmileForm" class="pa-form-card mb-4">
                <h2 class="h6 fw-bold mb-3">Upload Images</h2>
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold text-secondary">Before Image</label>
                        <div class="pa-upload-zone" data-preview-target="previewBefore">
                            <input type="file" accept="image/*" aria-label="Upload before image" />
                            <div class="pa-upload-placeholder text-center">
                                <div class="pa-upload-icon mx-auto"><i class="bi bi-image"></i></div>
                                <div class="pa-upload-label">Before Image</div>
                                <div class="pa-upload-hint">Click or drag to upload</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold text-secondary">Smile Image</label>
                        <div class="pa-upload-zone" data-preview-target="previewSmile">
                            <input type="file" accept="image/*" aria-label="Upload smile image" />
                            <div class="pa-upload-placeholder text-center">
                                <div class="pa-upload-icon mx-auto"><i class="bi bi-emoji-smile"></i></div>
                                <div class="pa-upload-label">Smile Image</div>
                                <div class="pa-upload-hint">Click or drag to upload</div>
                            </div>
                        </div>
                    </div>
                </div>

                <h2 class="h6 fw-bold mb-3">Clinical Measurements</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="UpperLipLength" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="UpperLipLength" class="pa-float-label"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="GingivalDisplay" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="GingivalDisplay" class="pa-float-label"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="SmileLineAngle" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="SmileLineAngle" class="pa-float-label"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="InterlabialGap" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="InterlabialGap" class="pa-float-label"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="MaxillaryIncisorDisplay" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="MaxillaryIncisorDisplay" class="pa-float-label"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="GummySmileRatio" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="GummySmileRatio" class="pa-float-label"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="LipMobility" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="LipMobility" class="pa-float-label"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="pa-float-group">
                            <input asp-for="VerticalMaxillaryExcess" class="pa-float-input" placeholder=" " type="number" step="0.1" />
                            <label asp-for="VerticalMaxillaryExcess" class="pa-float-label"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4 pt-2">
                    <button type="button" id="analyzeGummyBtn" class="btn cc-btn-primary px-4">
                        <i class="bi bi-stars me-2"></i>Analyze
                    </button>
                    <button type="button" id="cancelGummyBtn" class="btn btn-outline-secondary px-4">Cancel</button>
                </div>
            </form>

            <!-- Result Section -->
            <div id="gummyResultSection" class="pa-result-card">
                <div class="pa-result-header">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 position-relative" style="z-index:1;">
                        <div>
                            <span class="pa-ai-badge mb-2"><i class="bi bi-stars"></i> AI Result</span>
                            <h2 class="h5 fw-bold mb-1" id="resultDiagnosis">Analysis pending</h2>
                            <p class="text-white-50 small mb-0"><i class="bi bi-clock me-1"></i><span id="resultTimestamp">—</span></p>
                        </div>
                        <div class="pa-confidence-ring" id="confidenceRing" style="--confidence: 0%;">
                            <span class="pa-confidence-value text-white" id="confidenceValue">—</span>
                        </div>
                    </div>
                </div>
                <div class="p-4">
                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <h3 class="h6 fw-bold mb-3">Uploaded Images</h3>
                            <div class="pa-preview-images">
                                <div class="pa-preview-thumb" id="resultBeforeThumb"><span>Before</span></div>
                                <div class="pa-preview-thumb" id="resultSmileThumb"><span>Smile</span></div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="pa-recommendation mb-3">
                                <div class="pa-recommendation-title"><i class="bi bi-lightbulb me-1"></i> AI Recommendation</div>
                                <p class="small mb-0" id="resultRecommendation">Complete the analysis to receive AI-generated clinical recommendations.</p>
                            </div>
                            <h3 class="h6 fw-bold mb-2">AI Insights</h3>
                            <div class="pa-insight-item">
                                <span class="pa-insight-dot"></span>
                                <span class="small">Gingival display measured against normative cephalometric references</span>
                            </div>
                            <div class="pa-insight-item">
                                <span class="pa-insight-dot"></span>
                                <span class="small">Smile line curvature analyzed for aesthetic harmony</span>
                            </div>
                            <div class="pa-insight-item">
                                <span class="pa-insight-dot"></span>
                                <span class="small">Treatment options ranked by predicted clinical outcome</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top">
                        <h3 class="h6 fw-bold mb-2">Doctor Notes</h3>
                        <textarea class="pa-notes-area" placeholder="Add clinical notes, treatment plan, or follow-up instructions…" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Preview Panel -->
        <div class="col-12 col-lg-5 col-xl-4">
            <div class="pa-preview-card">
                <div class="pa-preview-head">
                    <h2 class="h6 fw-bold mb-0">Live Preview</h2>
                </div>
                <div class="pa-preview-body">
                    <div class="pa-preview-images mb-3">
                        <div>
                            <div class="small text-secondary mb-1 fw-bold">Before</div>
                            <div class="pa-preview-thumb" id="previewBefore"><span>No image</span></div>
                        </div>
                        <div>
                            <div class="small text-secondary mb-1 fw-bold">Smile</div>
                            <div class="pa-preview-thumb" id="previewSmile"><span>No image</span></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="small text-secondary mb-2 fw-bold">AI Status</div>
                        <div class="pa-ai-status" id="gummyAiStatus">
                            <i class="bi bi-cpu"></i>
                            <span class="pa-status-text">Ready to analyze</span>
                        </div>
                    </div>

                    <div>
                        <div class="small text-secondary mb-2 fw-bold">Result Preview</div>
                        <div id="gummyResultPreview">
                            <p class="small text-secondary mb-0">Upload images and click Analyze to generate AI-powered diagnosis and recommendations.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/patient-analysis.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.pa-upload-zone').forEach(function (zone) {
            zone.addEventListener('pa:image-uploaded', function (e) {
                var target = zone.dataset.previewTarget;
                if (target === 'previewBefore') {
                    var thumb = document.getElementById('resultBeforeThumb');
                    if (thumb) thumb.innerHTML = '<img src="' + e.detail.src + '" alt="Before" />';
                }
                if (target === 'previewSmile') {
                    var thumb = document.getElementById('resultSmileThumb');
                    if (thumb) thumb.innerHTML = '<img src="' + e.detail.src + '" alt="Smile" />';
                }
            });
        });
    </script>
}
