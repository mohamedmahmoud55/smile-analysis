@using System.Net
@model SmileAnalysisBl.ViewModels.PatientViewModels.PatientRecordsPageViewModel
@{
    ViewData["Title"] = "Patient records";
    var rev = Model.MonthlyRevenue;
    var revenueDisplay = rev >= 1000 ? $"${(rev / 1000m):0.#}k" : $"${rev:0}";
    var growthSigned = Model.PatientGrowthPercent >= 0 ? "+" : "";
}

<div class="cc-page">
    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="cc-topbar d-flex flex-wrap align-items-center justify-content-between gap-3">
        <form class="cc-search-wrap flex-grow-1" method="get" asp-action="Index" asp-controller="Patient">
            <i class="bi bi-search"></i>
            <input type="search" name="q" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="Search patient records..." autocomplete="off" />
        </form>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="cc-icon-btn" title="Notifications" aria-label="Notifications"><i class="bi bi-bell"></i></button>
            <button type="button" class="cc-icon-btn" title="Help" aria-label="Help"><i class="bi bi-question-circle"></i></button>
            <button type="button" class="cc-icon-btn" title="Settings" aria-label="Settings"><i class="bi bi-gear"></i></button>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">@(Model.IsDoctorMyPatientsView ? "My patients" : "Patient records")</h2>
            <p class="text-secondary mb-0 small">
                @(Model.IsDoctorMyPatientsView
                    ? "Patients who have booked an appointment with you. You can view and update their details."
                    : "Manage and monitor comprehensive patient history and appointments.")
            </p>
        </div>
        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
        {
            <a class="btn cc-btn-primary d-inline-flex align-items-center gap-2" asp-action="Create">
                <i class="bi bi-plus-lg"></i>
                Add new patient
            </a>
        }
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cc-bento-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                        <i class="bi bi-person fs-5"></i>
                    </div>
                    <span class="small fw-bold text-success bg-success-subtle px-2 py-1 rounded-pill">@growthSigned@Model.PatientGrowthPercent%</span>
                </div>
                <p class="cc-bento-label mb-1">Total patients</p>
                <p class="cc-bento-value mb-0">@Model.TotalPatients.ToString("N0")</p>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cc-bento-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-calendar-check fs-5"></i>
                    </div>
                    <span class="small fw-bold text-secondary">Today</span>
                </div>
                <p class="cc-bento-label mb-1">Scheduled today</p>
                <p class="cc-bento-value mb-0">@Model.ScheduledToday</p>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cc-bento-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="p-2 rounded-3 bg-secondary-subtle text-secondary-emphasis">
                        <i class="bi bi-journal-text fs-5"></i>
                    </div>
                </div>
                <p class="cc-bento-label mb-1">Upcoming appointments</p>
                <p class="cc-bento-value mb-0">@Model.UpcomingAppointments.ToString("D2")</p>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cc-bento-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="p-2 rounded-3 bg-success-subtle text-success-emphasis">
                        <i class="bi bi-currency-dollar fs-5"></i>
                    </div>
                </div>
                <p class="cc-bento-label mb-1">Monthly revenue</p>
                <p class="cc-bento-value mb-0">@revenueDisplay</p>
            </div>
        </div>
    </div>

    <div class="cc-data-card">
        <div class="cc-card-head px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h3 class="h6 fw-bold mb-0 text-dark">@(Model.IsDoctorMyPatientsView ? "Your appointment patients" : "Active patient directory")</h3>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-light border text-secondary fw-bold" disabled>Filter</button>
                <button type="button" class="btn btn-sm btn-light border text-secondary fw-bold" disabled>Export PDF</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table cc-table mb-0">
                <thead>
                <tr>
                    <th class="ps-4">Patient ID</th>
                    <th>Name</th>
                    <th>Contact</th>
                    <th>Last visit</th>
                    <th>Next appointment</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr class="cc-table-row border-top border-light">
                        <td class="ps-4"><span class="cc-pill-id">@row.DisplayId</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="cc-avatar @row.AvatarClass">@row.Initials</span>
                                <a asp-action="Details" asp-route-id="@row.Id" class="small fw-bold text-dark text-decoration-none">@row.FullName</a>
                            </div>
                        </td>
                        <td class="small text-secondary">@row.ContactDisplay</td>
                        <td class="small text-secondary">@row.LastVisitDisplay</td>
                        <td><span class="@row.NextAppointmentBadgeClass">@row.NextAppointmentLabel</span></td>
                        <td class="text-end pe-4">
                            <div class="cc-table-actions d-flex justify-content-end gap-1 align-items-center">
                                <a class="btn btn-link btn-sm p-1 text-primary" asp-action="Details" asp-route-id="@row.Id" title="View details"><i class="bi bi-eye"></i></a>
                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Staff") || User.IsInRole("Doctor"))
                                {
                                    <a class="btn btn-link btn-sm p-1 text-secondary" asp-action="Edit" asp-route-id="@row.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                }
                                else
                                {
                                    <span class="btn btn-link btn-sm p-1 text-secondary disabled opacity-50"><i class="bi bi-pencil"></i></span>
                                }
                                @if (!Model.IsDoctorMyPatientsView)
                                {
                                    <a class="btn btn-link btn-sm p-1 text-secondary" asp-controller="Appointment" asp-action="Create" asp-route-patientId="@row.Id" title="Schedule appointment"><i class="bi bi-calendar3"></i></a>
                                }
                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
                                {
                                    <button type="button"
                                            class="btn btn-link btn-sm p-1 text-danger"
                                            title="Delete"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deletePatientModal"
                                            data-delete-url="@Url.Action("Delete", "Patient", new { id = row.Id })"
                                            data-item-name="@WebUtility.HtmlEncode(row.FullName)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="btn btn-link btn-sm p-1 text-danger disabled opacity-50"><i class="bi bi-trash"></i></span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-5">
                            @(Model.IsDoctorMyPatientsView
                                ? (string.IsNullOrWhiteSpace(Model.SearchQuery) ? "No patients have appointments with you yet." : "No patients match your search.")
                                : "No patients match your search.")
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="px-4 py-3 border-top border-light bg-body-secondary bg-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <p class="small text-secondary mb-0">
                Showing @(Model.Rows.Count == 0 ? 0 : 1) to @Model.Rows.Count of @Model.MatchingCount.ToString("N0") patients
            </p>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-light border-0" disabled aria-label="Previous page"><i class="bi bi-chevron-left"></i></button>
                <span class="btn btn-sm btn-primary px-2">1</span>
                <button type="button" class="btn btn-sm btn-light border-0" disabled aria-label="Next page"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>

    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
    {
        <div class="modal fade" id="deletePatientModal" tabindex="-1" aria-labelledby="deletePatientModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
                    <div class="modal-header border-0 border-bottom bg-body-tertiary py-3">
                        <div class="d-flex align-items-center gap-3 flex-grow-1">
                            <div class="rounded-3 bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center flex-shrink-0" style="width: 3rem; height: 3rem;">
                                <i class="bi bi-person-x fs-4"></i>
                            </div>
                            <div>
                                <h2 class="modal-title h5 fw-bold text-dark mb-0" id="deletePatientModalTitle">Remove patient</h2>
                                <p class="small text-secondary mb-0">This cannot be undone.</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-4">
                        <p class="text-secondary mb-0" id="deletePatientModalMessage"></p>
                    </div>
                    <div class="modal-footer border-0 bg-light bg-opacity-50 gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <form method="post" id="deletePatientModalForm" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger rounded-pill px-4">Remove patient</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
{
    <a class="cc-fab" asp-action="Create" title="Add patient"><i class="bi bi-file-medical"></i></a>
}

@section Scripts {
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
    {
        <script>
            document.getElementById('deletePatientModal')?.addEventListener('show.bs.modal', function (event) {
                const trigger = event.relatedTarget;
                if (!trigger) return;
                const url = trigger.getAttribute('data-delete-url');
                const name = trigger.getAttribute('data-item-name') || 'this patient';
                const form = document.getElementById('deletePatientModalForm');
                const msg = document.getElementById('deletePatientModalMessage');
                if (form && url) form.setAttribute('action', url);
                if (msg) msg.textContent = 'Remove "' + name + '" from the patient directory? Related appointments and billing may be affected.';
            });
        </script>
    }
}
